# Environment Variables Template for Talk Talk Goose
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to git!

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# MongoDB Database Connection
# For production: Use MongoDB Atlas connection string
# For local dev: mongodb://admin:password@mongodb:27017/talkgoose?authSource=admin
MONGO=mongodb+srv://username:password@cluster.mongodb.net/ttg?appName=TalkTalkGoose

# Clerk Authentication
# Get from: https://dashboard.clerk.com/
CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ImageKit CDN
# Get from: https://imagekit.io/dashboard/developer/api-keys
IMAGE_KIT_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGE_KIT_PUBLIC_KEY=public_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
IMAGE_KIT_PRIVATE_KEY=private_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Server Configuration
# For Docker: http://localhost (frontend will be on port 80)
# For cloud deployment: https://your-frontend-domain.com
CLIENT_URL=http://localhost
PORT=3000

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# Clerk Authentication (same publishable key as backend)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Gemini AI API Key
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ImageKit CDN (same as backend)
VITE_IMAGE_KIT_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
VITE_IMAGE_KIT_PUBLIC_KEY=public_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Backend API URL
# For Docker: http://localhost:3000 (backend container)
# For production: https://your-backend-domain.com
VITE_API_URL=http://localhost:3000

# ============================================
# OPTIONAL: Local MongoDB (if not using Atlas)
# ============================================
# MONGO_USER=admin
# MONGO_PASSWORD=password
