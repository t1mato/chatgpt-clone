# Backend .dockerignore
# Prevents unnecessary files from being copied into Docker image

# Node dependencies (will be installed in container)
node_modules
npm-debug.log
yarn-error.log

# Environment files (use docker-compose env vars instead)
.env
.env.local
.env.*.local

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
README.md
CLAUDE.md
DEPLOYMENT.md

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Testing
coverage
.nyc_output

# Misc
.cache
temp
tmp
