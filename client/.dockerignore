# Frontend .dockerignore
# Prevents unnecessary files from being copied into Docker image

# Node dependencies (will be installed in container)
node_modules
npm-debug.log
yarn-error.log

# Build output (will be generated in container)
dist
dist-ssr
*.local

# Environment files (passed as build args instead)
.env
.env.local
.env.*.local

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
README.md
CLAUDE.md
DEPLOYMENT.md

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage
.nyc_output
__tests__
**/*.test.js
**/*.test.jsx
**/*.spec.js
**/*.spec.jsx

# Misc
.cache
.eslintcache
temp
tmp
